# Exit Three - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# APPLICATION SETTINGS
# ============================================
NUXT_PUBLIC_BASE_URL=https://www.exit3.online
NODE_ENV=production

# ============================================
# GOOGLE TAG MANAGER
# ============================================
NUXT_PUBLIC_GTAG_ID=GTM-XXXXXXX

# ============================================
# BACKEND API AUTHENTICATION
# ============================================
# IMPORTANT: This should be kept secret and NOT exposed in public runtime config
# Use BASIC_API_KEY (without NUXT_PUBLIC_ prefix) for server-side only access
BASIC_API_KEY=your_backend_api_key_here

# ============================================
# EMAIL CONFIGURATION (Optional - if using /api/send-email endpoint)
# ============================================
# SMTP server settings for sending emails via Nodemailer
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=465
MAIL_USER=noreply@exit3.online
MAIL_PASS=your_smtp_password_here

# ============================================
# OPTIONAL: ERROR MONITORING
# ============================================
# Sentry DSN for error tracking (recommended for production)
# NUXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ============================================
# OPTIONAL: ENVIRONMENT IDENTIFIER
# ============================================
# Useful for preventing staging sites from being indexed
# ENVIRONMENT=production  # or 'staging', 'preview', 'development'

# ============================================
# NOTES
# ============================================
# - Variables prefixed with NUXT_PUBLIC_ are exposed to the browser
# - Variables without NUXT_PUBLIC_ are server-side only
# - Never commit .env files to version control
# - Keep API keys and secrets secure
